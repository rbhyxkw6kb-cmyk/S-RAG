# DeepSeek API。密钥可在运行服务的环境变量或本机 .env 中设置。
ZHIYUAN_LLM_BASE_URL=https://api.deepseek.com
ZHIYUAN_LLM_MODEL_NAME=deepseek-flash
DEEPSEEK_API_KEY=

# 安装 requirements-rag.txt 后可启用本地中文向量模型
# ZHIYUAN_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# ZHIYUAN_RAG_EMBEDDING_PATH=./data/models/bge-small-zh-v1.5
# ZHIYUAN_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# ZHIYUAN_RAG_RERANKER_PATH=./data/models/bge-reranker-base

# 内网 HTTPS 部署可配置 staff 和 admin 的独立密码
# ZHIYUAN_STAFF_PASSWORD=
# ZHIYUAN_ADMIN_PASSWORD=

# 单进程并发保护。实际阈值需结合换班流量和模型服务配额校准。
# ZHIYUAN_QUERY_MAX_INFLIGHT=32
# ZHIYUAN_QUERY_MAX_PER_STATION=4
# ZHIYUAN_QUERY_WORKER_THREADS=4
# ZHIYUAN_LLM_MAX_INFLIGHT=8
# ZHIYUAN_LLM_REQUESTS_PER_MINUTE=0
# ZHIYUAN_LLM_QUEUE_SECONDS=0.2
# ZHIYUAN_LLM_BUDGET_SECONDS=8
# ZHIYUAN_LLM_CONNECT_SECONDS=2
# ZHIYUAN_LLM_BREAKER_FAILURES=3
# ZHIYUAN_LLM_BREAKER_COOLDOWN=15
